{
  "manifest_version": 3,
  "name": "Arcane Page Destroy",
  "description": "Удержание клавиши закрывает вкладку роликом и разбивает страницу.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcane-page-destroy@mavotronik",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage", "tabs", "theme"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "src/options.html"
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/defaults.js", "src/shatter.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["arcane_ultimate_2_arcane-only.mp4"],
      "matches": ["<all_urls>"]
    }
  ]
}
